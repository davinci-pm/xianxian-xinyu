# 后端数据库；默认值等价于此路径。
DATABASE_URL=sqlite+pysqlite:///../data/first_sage.db
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REQUIRED=false
INVITE_CODES=
SESSION_SECRET=
COOKIE_SECURE=false

# 线上 TOS（S3 兼容）数据库备份；本地开发保持 local。
STORAGE_PROVIDER=local
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
DB_BACKUP_KEY=db/persona-chat.db
DB_BACKUP_INTERVAL_SECONDS=300
DB_BACKUP_KEEP_VERSIONS=12

# 默认 Mock 可跑通全部业务。下面示例可切换为 DeepSeek 官方 API。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=90
# 思考型模型会同时消耗 reasoning 和最终正文预算，内容完整性优先。
LLM_MAX_TOKENS=4096
LLM_RETRY_ATTEMPTS=3

# 推荐的人物对话模型（火山方舟）：注册后将上方四项替换为以下值。
# LLM_PROVIDER=doubao
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-seed-character-260628
# LLM_API_KEY=只在本机填写方舟密钥

# 对话意图识别单独走千问旗舰模型。未配置或调用失败时自动回退本地规则。
INTENT_LLM_ENABLED=false
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTENT_LLM_MODEL=qwen3.8-flash
INTENT_LLM_TIMEOUT_SECONDS=1.5
INTENT_LLM_REASONING_EFFORT=none
INTENT_LOCAL_FAST_PATH_ENABLED=true
INTENT_LOCAL_FAST_PATH_THRESHOLD=0.82

# 本地混合 RAG：FastEmbed + BGE 中文向量，语料和向量均保留在本机。
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHUNK_CHARS=520
RAG_CHUNK_OVERLAP_CHARS=80
RAG_KEYWORD_CANDIDATES=12
RAG_VECTOR_CANDIDATES=12
RAG_FINAL_LIMIT=4
